# Used by the db container to create the database on first start.
POSTGRES_USER=shortener
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=url_shortener

# Used when running the app or Alembic from your machine (outside Docker).
# Port 5433 is the port compose.yaml publishes for Postgres.
DATABASE_URL=postgresql+psycopg://shortener:change-me-locally@localhost:5433/url_shortener